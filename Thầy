-- HÀM QUY ĐỔI GIÂY SANG GIỜ/PHÚT
local function formatTime(seconds)
    if not seconds or seconds <= 0 then return "Vừa hết hạn" end
    local hours = math.floor(seconds / 3600)
    local mins = math.floor((seconds % 3600) / 60)
    
    if hours > 0 then
        return string.format("%d giờ %d phút", hours, mins)
    elseif mins > 0 then
        return string.format("%d phút", mins)
    else
        return string.format("%d giây", math.floor(seconds))
    end
end

function lEncode(data) return HttpService:JSONEncode(data) end
function lDecode(data) return HttpService:JSONDecode(data) end
local function lDigest(input)
    local inputStr = tostring(input)
    local hash = {}
    for i = 1, #inputStr do table.insert(hash, string.byte(inputStr, i)) end
    local hashHex = ""
    for _, byte in ipairs(hash) do hashHex = hashHex .. string.format("%02x", byte) end
    return hashHex
end

function cacheLink()
    if cachedTime + (10*60) < fOsTime() then
        local success, response = pcall(function()
            return fRequest({
                Url = host .. "/public/start",
                Method = "POST",
                Body = lEncode({ service = service, identifier = lDigest(fGetHwid()) }),
                Headers = { ["Content-Type"] = "application/json" }
            });
        end)
        if success and response and response.StatusCode == 200 then
            local decoded = lDecode(response.Body);
            if decoded.success == true then
                cachedLink = decoded.data.url;
                cachedTime = fOsTime();
                return true, cachedLink;
            end
        end
        return false, "Lỗi tạo link."
    else
        return true, cachedLink;
    end
end

local generateNonce = function()
    local str = ""
    for _ = 1, 16 do str = str .. fStringChar(fMathFloor(fMathRandom() * (122 - 97 + 1)) + 97) end
    return str
end

-- XÁC THỰC KEY VÀ XỬ LÝ CHÍNH XÁC TIMESTAMP
local verifyKey = function(key)
    if not fRequest then return false, "Lỗi Yêu Cầu Network" end
    local nonce = generateNonce();
    local endpoint = host .. "/public/whitelist/" .. fToString(service) .. "?identifier=" .. lDigest(fGetHwid()) .. "&key=" .. key;
    if useNonce then endpoint = endpoint .. "&nonce=" .. nonce; end

    local success, response = pcall(function()
        return fRequest({ Url = endpoint, Method = "GET" });
    end)

    if success and response and response.StatusCode == 200 then
        local decoded = lDecode(response.Body);
        if decoded.success == true and decoded.data and decoded.data.valid == true then
            local data = decoded.data
            local expireInfo = "Hợp lệ (Key 24 Giờ)" -- Fallback nếu không có data thời gian
            
            -- Ưu tiên tìm mốc thời gian hết hạn (Timestamp)
            local expireTimestamp = data.expires_at or data.expire_at or data.expiration or data.expires
            
            if expireTimestamp and type(expireTimestamp) == "number" then
                -- Nếu timestamp > 10 tỷ, hệ thống Platoboost đang trả về mili-giây thay vì giây
                if expireTimestamp > 9999999999 then
                    expireTimestamp = expireTimestamp / 1000
                end
                
                -- Trừ cho thời gian hiện tại của thiết bị (đã đồng bộ UTC)
                local remainingSeconds = expireTimestamp - fOsTime()
                
                if remainingSeconds > 0 then
                    expireInfo = formatTime(remainingSeconds)
                else
                    expireInfo = "0 giờ 0 phút"
                end
            end
            
            return true, expireInfo
        end
    end
    return false, "Key Không Hợp Lệ Hoặc Hết Hạn"
end

