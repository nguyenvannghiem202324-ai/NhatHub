local function createPreview(model, parent)
    local viewport = Instance.new("ViewportFrame")
    viewport.Name = "Pet3DPreview"
    viewport.Size = UDim2.new(0, 48, 0, 47)
    viewport.Position = UDim2.new(0, 3, 0.5, -23)
    viewport.BackgroundColor3 = Color3.fromRGB(242, 207, 151)
    viewport.BackgroundTransparency = 0
    viewport.BorderSizePixel = 0
    viewport.Ambient = Color3.fromRGB(210, 210, 210)
    viewport.LightColor = Color3.fromRGB(255, 244, 224)
    viewport.LightDirection = Vector3.new(-1, -1, -1)
    viewport.ClipsDescendants = true
    viewport.Parent = parent

    Instance.new("UICorner", viewport).CornerRadius = UDim.new(0, 4)
    outline(viewport, Color3.fromRGB(89,54,29), 1)

    local world = Instance.new("WorldModel")
    world.Parent = viewport

    local camera = Instance.new("Camera")
    camera.FieldOfView = 30
    camera.Parent = viewport
    viewport.CurrentCamera = camera

    local ok, clone = pcall(function()
        return model:Clone()
    end)
    if not ok or not clone then return end

    for _, item in ipairs(clone:GetDescendants()) do
        if item:IsA("Script") or item:IsA("LocalScript") then
            item:Destroy()
        elseif item:IsA("BasePart") then
            item.Anchored = true
            item.CanCollide = false
            item.CastShadow = false
        end
    end

    clone.Parent = world

    local success, boxCFrame, size = pcall(function()
        return clone:GetBoundingBox()
    end)
    if not success or not size then
        clone:Destroy()
        return
    end

    -- Đưa tâm của pet về gốc để căn giữa ổn định trong ô 3D.
    local center = boxCFrame.Position
    pcall(function()
        clone:PivotTo(clone:GetPivot() - center)
    end)

    local largest = math.max(size.X, size.Y, size.Z, 0.5)
    local radius = math.sqrt(size.X * size.X + size.Y * size.Y + size.Z * size.Z) * 0.5
    local fovRadians = math.rad(camera.FieldOfView)
    local distance = math.max((radius / math.tan(fovRadians * 0.5)) * 1.12, largest * 1.15, 1.5)
    local focus = Vector3.new(0, size.Y * 0.04, 0)
    local viewDirection = Vector3.new(1, 0.38, 1).Unit
    camera.CFrame = CFrame.lookAt(focus + viewDirection * distance, focus)
end
