-- Đóng/mở bằng hiệu ứng trượt; dùng menuOpen khai báo trước để bảng cài đặt cập nhật đúng.
local menuOpen = false
local menuAnimating = false
local slideTween
local function hiddenMenuPosition()
    local width = Main.AbsoluteSize.X * mainScale.Scale
    return UDim2.new(1,width+32,openPosition.Y.Scale,positionY)
end
local function setMenuOpen(wantOpen)
    if menuAnimating or menuOpen == wantOpen then return end
    menuAnimating=true; menuOpen=wantOpen
    if slideTween then pcall(function() slideTween:Cancel() end) end
    if wantOpen then
        Main.Position=hiddenMenuPosition(); Main.Visible=true
        Toggle.Visible=false; SettingsButton.Visible=true
    else
        Toggle.Visible=true; SettingsButton.Visible=false; Settings.Visible=false
    end
    local target=wantOpen and openPosition or hiddenMenuPosition()
    slideTween=TweenService:Create(Main,TweenInfo.new(0.32,Enum.EasingStyle.Quint,Enum.EasingDirection.Out),{Position=target})
    slideTween:Play()
    slideTween.Completed:Connect(function(state)
        if not gui.Parent then return end
        if state==Enum.PlaybackState.Completed then
            if wantOpen then Main.Position=openPosition; Main.Visible=true; Toggle.Visible=false
            else Main.Visible=false; Toggle.Visible=true end
        end
        menuAnimating=false
    end)
end

