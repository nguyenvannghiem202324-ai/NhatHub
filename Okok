--================ RESET AND TELEPORT =================

local function resetAndWait()
    local oldCharacter = getCharacter()
    local humanoid = getHumanoid(oldCharacter)

    if not humanoid then return false end

    setStatus("Đang reset nhân vật...")
    pcall(function()
        humanoid.Health = 0
    end)

    local started = os.clock()

    repeat
        task.wait(0.1)

        local character = getCharacter()
        local newHumanoid = getHumanoid(character)
        local root = getRoot(character)

        if character and character ~= oldCharacter
        and newHumanoid and root and newHumanoid.Health > 0 then
            task.wait(0.25)
            return true
        end
    until os.clock() - started > 15

    local character = getCharacter()
    return getHumanoid(character) ~= nil
        and getRoot(character) ~= nil
        and getHumanoid(character).Health > 0
end

local function teleportCharacter(position)
    local character = getCharacter()
    local humanoid = getHumanoid(character)
    local root = getRoot(character)

    if not character or not humanoid or not root
    or humanoid.Health <= 0 then
        return false
    end

    return pcall(function()
        character:PivotTo(CFrame.new(position))
    end)
end

local function teleportNearPet(model)
    local position = getPetPosition(model)
    if not position then return false end

    return teleportCharacter(position + Vector3.new(0, 3, 0))
end

--================ PROMPT SEARCH =================

local function preparePrompt(prompt)
    if not prompt or not prompt:IsA("ProximityPrompt") then
        return
    end

    pcall(function()
        prompt.HoldDuration = 0
        prompt.RequiresLineOfSight = false
    end)
end

-- Tìm prompt bên trong pet, ở các đối tượng cha và ở gần pet.
-- Chỉ thử prompt ở khoảng cách gần để tránh kích hoạt prompt xa.
local function getNearbyPrompts(model)
    local results = {}
    local seen = {}

    local petPosition = getPetPosition(model)
    if not petPosition then return results end

    local function addPrompt(prompt)
        if not prompt:IsA("ProximityPrompt") or seen[prompt] then
            return
        end

        local parent = prompt.Parent
        local part

        if parent and parent:IsA("BasePart") then
            part = parent
        elseif parent then
            part = parent:FindFirstChildWhichIsA("BasePart", true)
        end

        if not part then return end

        local distance = (part.Position - petPosition).Magnitude
        if distance <= 14 then
            seen[prompt] = true
            table.insert(results, {
                Prompt = prompt,
                Distance = distance,
            })
        end
    end

    -- Prompt nằm trong model pet.
    for _, object in ipairs(model:GetDescendants()) do
        if object:IsA("ProximityPrompt") then
            addPrompt(object)
        end
    end

    -- Prompt có thể nằm trên model cha hoặc đối tượng bao quanh.
    local current = model.Parent
    local folder = getPetFolder()

    while current and current ~= folder do
        if current:IsA("Model") or current:IsA("Folder") then
            for _, object in ipairs(current:GetDescendants()) do
                if object:IsA("ProximityPrompt") then
                    addPrompt(object)
                end
            end
        end
        current = current.Parent
    end

    -- Tìm thêm prompt gần vị trí pet.
    for _, object in ipairs(Workspace:GetDescendants()) do
        if object:IsA("ProximityPrompt") then
            addPrompt(object)
        end
    end

    table.sort(results, function(a, b)
        return a.Distance < b.Distance
    end)

    return results
end

local function tryPickup(model)
    local prompts = getNearbyPrompts(model)
    local fired = 0

    for _, entry in ipairs(prompts) do
        local prompt = entry.Prompt

        if prompt and prompt.Parent then
            preparePrompt(prompt)

            if typeof(fireproximityprompt) == "function" then
                local ok = pcall(function()
                    fireproximityprompt(prompt, 0)
                end)

                if ok then
                    fired += 1
                end
            end
        end
    end

    return fired, #prompts
end

--================ VERIFY PICKUP =================

local function waitForPetChange(model, originalParent)
    local started = os.clock()

    while os.clock() - started < VERIFY_TIMEOUT do
        task.wait(0.2)

        if not model:IsDescendantOf(Workspace) then
            return true
        end

        -- Chỉ xem là thay đổi nếu model không còn ở parent ban đầu.
        if originalParent and model.Parent ~= originalParent then
            return true
        end
    end

    return false
end

--================ PICKUP SEQUENCE =================

local function startPetSequence(model)
    if busy then
        setStatus("Đang xử lý pet khác...")
        return
    end

    if not model or not model:IsDescendantOf(Workspace) then
        setStatus("Pet không còn trên map")
        return
    end

    busy = true

    task.spawn(function()
        local ok, err = pcall(function()
            local originalParent = model.Parent

            -- 1. Reset và đợi hồi sinh.
            if not resetAndWait() then
                setStatus("Không thể hồi sinh nhân vật")
                return
            end

            if not model:IsDescendantOf(Workspace) then
                setStatus("Pet đã biến mất")
                return
            end

            -- 2. Đến gần pet.
            if not teleportNearPet(model) then
                setStatus("Không thể đến gần pet")
                return
            end

            task.wait(0.5)

            -- 3. Thử kích hoạt prompt nhiều lần.
            setStatus("Đang thử bế pet...")

            local startTime = os.clock()
            local totalPrompts = 0

            repeat
                if not model:IsDescendantOf(Workspace) then
                    break
                end

                local _, found = tryPickup(model)
                totalPrompts = math.max(totalPrompts, found)

                task.wait(0.5)
            until os.clock() - startTime >= PICKUP_ATTEMPT_TIME

            if totalPrompts == 0 then
                setStatus("Không tìm thấy prompt gần pet")
            end

            -- 4. Chờ trạng thái pet thay đổi.
            local changed = waitForPetChange(model, originalParent)

            if changed then
                -- 5. Trở về tọa độ mới.
                setStatus("Pet đã thay đổi - đang trở về...")
                task.wait(0.2)
                teleportCharacter(RETURN_POSITION)
                task.wait(0.4)

                -- 6. Reset thêm một lần (RESET LẦN 2).
                if not resetAndWait() then
                    setStatus("Không thể hồi sinh lần 2")
                    return
                end

                -- 7. Sau reset lần 2, teleport lại tọa độ thứ nhất.
                if not teleportCharacter(RETURN_POSITION) then
                    setStatus("Không thể teleport lại vị trí thứ nhất")
                    return
                end

                task.wait(0.5)

                -- 8. Chạy lại logic auto bê pet sau reset lần 2.
                -- Nếu game đã thay instance pet sau lần reset/nhặt đầu tiên,
                -- tìm lại model cùng tên trong AnimalPickups.
                local targetModel = model
                local targetName = model.Name

                if not targetModel:IsDescendantOf(Workspace) then
                    local folder = getPetFolder()
                    targetModel = nil
                    if folder then
                        for _, candidate in ipairs(folder:GetDescendants()) do
                            if candidate:IsA("Model") and candidate.Name == targetName then
                                targetModel = candidate
                                break
                            end
                        end
                    end
                end

                if not targetModel or not targetModel:IsDescendantOf(Workspace) then
                    setStatus("Không tìm thấy pet mục tiêu sau reset lần 2; không teleport vị trí cuối")
                    return
                end

                -- Quan trọng: ở tọa độ -99 có thể đang quá xa prompt.
                -- Tiếp cận lại pet trước khi kích hoạt prompt như lần đầu.
                if not teleportNearPet(targetModel) then
                    setStatus("Không thể đến gần pet để bê lần 2")
                    return
                end
                task.wait(0.5)

                local retryParent = targetModel.Parent
                setStatus("Đang tự động bê pet sau reset lần 2...")

                local retryStart = os.clock()
                local retryPrompts = 0
                local carriedSecondTime = false

                repeat
                    if not targetModel:IsDescendantOf(Workspace) then
                        carriedSecondTime = true
                        break
                    end

                    local _, found = tryPickup(targetModel)
                    retryPrompts = math.max(retryPrompts, found)

                    -- Kiểm tra liên tục trong khi thử bê; không chờ hết vòng
                    -- rồi mới bắt đầu xác minh trạng thái.
                    if not targetModel:IsDescendantOf(Workspace)
                    or (retryParent and targetModel.Parent ~= retryParent) then
                        carriedSecondTime = true
                        break
                    end

                    task.wait(0.5)
                until os.clock() - retryStart >= PICKUP_ATTEMPT_TIME

                if not carriedSecondTime then
                    carriedSecondTime = waitForPetChange(targetModel, retryParent)
                end

                if not carriedSecondTime then
                    if retryPrompts == 0 then
                        setStatus("Không tìm thấy prompt để bê pet lần 2")
                    else
                        setStatus("Chưa xác nhận bê thành công lần 2; giữ nguyên vị trí")
                    end
                    return
                end

                -- 9. Chỉ sau khi xác nhận thay đổi trong lần bê thứ hai mới đi vị trí cuối.
                setStatus("Đã xác nhận pet được bê lần 2 - đang đến vị trí cuối...")
                if teleportCharacter(Vector3.new(-52.98, 3.50, 0.22)) then
                    setStatus("Đã chạy xong chuỗi thao tác")
                else
                    setStatus("Không thể teleport đến vị trí cuối")
                end
            else
                setStatus("Chưa xác nhận lấy được pet")
            end
        end)

        if not ok then
            setStatus("Lỗi: " .. tostring(err))
        end

        busy = false
    end)
end

