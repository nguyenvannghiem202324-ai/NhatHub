local function scanPets()
    local folder = getPetFolder()

    if not folder then
        setStatus("Không tìm thấy AnimalPickups")
        return
    end

    local found = {}

    for _, object in ipairs(folder:GetDescendants()) do
        if object:IsA("TextLabel") and object.Visible then
            local money = parseNumber(object.Text)

            if money > 0 then
                local current = object.Parent

                while current and current ~= folder
                and not current:IsA("Model") do
                    current = current.Parent
                end

                if current and current:IsA("Model") then
                    local oldData = found[current]

                    if not oldData or money > oldData.Money then
                        found[current] = {
                            Model = current,
                            Name = current.Name,
                            Money = money,
                        }
                    end
                end
            end
        end
    end

    local dataList = {}
    for _, data in pairs(found) do
        table.insert(dataList, data)
    end

    table.sort(dataList, function(a, b)
        return a.Money > b.Money
    end)

    local present = {}

    for index, data in ipairs(dataList) do
        local model = data.Model
        present[model] = true

        local row = rows[model]

        if not row or not row.Parent then
            rows[model] = createRow(data, index)
        else
            row.LayoutOrder = index

            local nameLabel = row:FindFirstChild("PetName")
            local moneyLabel = row:FindFirstChild("PetIncome")

            if nameLabel then nameLabel.Text = data.Name end
            if moneyLabel then
                moneyLabel.Text = "$" .. formatNumber(data.Money) .. "/s"
            end
        end
    end

    for model, row in pairs(rows) do
        if not present[model] then
            if row and row.Parent then row:Destroy() end
            rows[model] = nil
        end
    end

    setStatus("Tìm thấy " .. #dataList .. " pet")
end

local function queueScan()
    if scanQueued or closed then return end
    scanQueued = true

    task.delay(0.25, function()
        scanQueued = false
        if not closed and gui.Parent then
            pcall(scanPets)
        end
    end)
end

