-- Responsive sizing for Android; keep the panel compact on narrow screens.
local function fitPanel()
    local camera = Workspace.CurrentCamera
    if not camera then return end
    local viewport = camera.ViewportSize
    local width = math.clamp(viewport.X * 0.42, 245, 286)
    local height = math.clamp(viewport.Y * 0.48, 270, 340)
    Main.Size = UDim2.fromOffset(width,height)
    if viewport.X < 600 then
        originalPosition = UDim2.new(1,-6,0.5,0)
    else
        originalPosition = UDim2.new(1,-10,0.5,0)
    end
    openPosition = UDim2.new(originalPosition.X.Scale, positionX, originalPosition.Y.Scale, positionY)
    if menuOpen then Main.Position = openPosition else Main.Position = hiddenMenuPosition() end
end
